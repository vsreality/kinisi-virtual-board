; Kinisi single-port software device, Windows 11 x64, UMDF 2.33.
[Version]
Signature="$Windows NT$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=kinisiport.cat
DriverVer=10/28/2026,0.2.0.1
PnpLockdown=1

[Manufacturer]
%Provider%=Kinisi,NTamd64.10.0...22000

[Kinisi.NTamd64.10.0...22000]
%Device%=Install,Kinisi\VirtualBoard

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Media%

[SourceDisksFiles]
kinisiport.dll=1

[Install.NT]
CopyFiles=DriverCopy
Include=WUDFRD.inf
Needs=WUDFRD.NT

[Install.NT.HW]
AddReg=DeviceType
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW

[DeviceType]
HKR,,DeviceType,0x10001,0x1b

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=KinisiPort,DriverService
UmdfServiceOrder=KinisiPort
UmdfKernelModeClientPolicy=RejectKernelModeClients
UmdfFileObjectPolicy=RejectNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CannotUseFsContexts

[DriverService]
UmdfLibraryVersion=2.33.0
ServiceBinary=%13%\kinisiport.dll

[DriverCopy]
kinisiport.dll

[Strings]
Provider="Kinisi"
Device="Kinisi simulated controller"
Media="Kinisi simulator driver package"
